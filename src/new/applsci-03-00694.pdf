         <xmp:MetadataDate>2013-12-10T14:27:22+08:00</xmp:MetadataDate>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:pdf="http://ns.adobe.com/pdf/1.3/">
         <pdf:Keywords>"ultrafast lasers; pulsed lasers; solid-state lasers; mode-locked lasers"</pdf:Keywords>
